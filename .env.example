# ── Railway (운영 API) ───────────────────────────────────────
# DATABASE_URL=postgresql://...
# FRONTEND_URL=https://your-app.vercel.app
# PUBLIC_API_URL=https://your-api.up.railway.app
# CRAWLER_SECRET=change-me-in-production
# JWT_SECRET=change-me-same-on-vercel-and-railway
#
# 운영 Postgres: synchronize 항상 OFF (테이블/데이터 보호).
# 스키마 변경은 TypeORM 마이그레이션으로 관리하며, 배포 시(migrationsRun) 자동 적용됩니다.
# 새 마이그레이션이 필요하면: DATABASE_URL을 운영 값으로 두고
#   npm run migration:generate -- src/migrations/설명
# 실행 후 생성된 파일을 커밋하세요.
#
# 운영 전체 삭제 API 차단 (관리자 UI 「전체 삭제」도 막힘). 필요 시에만:
# ALLOW_DELETE_ALL=true
#
# Railway Postgres 볼륨/서비스 삭제·재생성 시 데이터가 통째로 사라집니다.
# Variables의 DATABASE_URL을 바꾸지 마세요. 백업(Backups)을 켜 두세요.

# 운영 웹 → 관리자 PC 크롤러 연결 (cloudflared 터널 URL)
# CRAWLER_WORKER_URL=https://xxxx.trycloudflare.com
# CRAWLER_WORKER_SECRET=change-me-crawler-worker-secret

# (선택) 운영 크롤 시 로컬 DB mirror — API(3001) 터널 URL + /crawler/import-item
# CRAWLER_MIRROR_URL=https://yyyy.trycloudflare.com/crawler/import-item

# ── 관리자 PC (로컬 API) ─────────────────────────────────────
# DATABASE_URL 없으면 data/auction.db (sql.js)

TANK_AUCTION_USER=
TANK_AUCTION_PASSWORD=

CRAWLER_WORKER_PORT=8765
CRAWLER_WORKER_SECRET=change-me-crawler-worker-secret

# AI 물건 분석 (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# RAG: 분석 시 참조할 경매지식 최대 건수
RAG_TOP_K=5

# 네이버 카페 → 경매지식 수집 (기본 카페 URL)
NAVER_CAFE_URL=https://cafe.naver.com/0113053470
# 네이버 자동 로그인 (선택 — 관리자 화면에서 저장하면 config.json에도 저장됨)
# NAVER_USER=
# NAVER_PASSWORD=
# 카페 Chrome 로그인 유지 프로필 (삭제 시 네이버 재로그인·추가인증 필요)
# 기본값: %LOCALAPPDATA%\\auction-crawler\\profiles\\chrome-profile-* (OneDrive 밖)
# OneDrive data/crawler 프로필은 최초 1회 쿠키만 이전 후 자동 삭제됩니다.
# CRAWLER_CHROME_PROFILE_CAFE=C:/Users/you/AppData/Local/auction-crawler/profiles/chrome-profile-cafe
# CRAWLER_CHROME_PROFILE_TANK=C:/Users/you/AppData/Local/auction-crawler/profiles/chrome-profile-tank
# CRAWLER_REMOVE_LEGACY_ONEDRIVE_PROFILE=0  # 구 OneDrive 프로필 폴더 유지
# CRAWLER_CHROME_PRUNE_CACHE=1              # Chrome 시작 시 캐시 폴더 정리

# 로컬 크롤 → 로컬 DB + Railway 운영 DB 동시 적재
CRAWLER_MIRROR_URL=https://your-api.up.railway.app/crawler/import-item
CRAWLER_SECRET=local-crawler-secret
PRODUCTION_API_URL=https://your-api.up.railway.app

# PYTHON_PATH=python

# 텔레그램 알림 — 알림톡 자동발송이 연속 실패하거나 다시 정상화될 때 알림.
# @BotFather로 봇 생성 후 발급받은 토큰과, 봇과 대화를 시작한 뒤 확인한
# chat_id를 입력. 설정하지 않으면 알림 기능이 조용히 비활성화됨.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SECURITY_PROXY_SECRET=frontend와 API가 공유하는 긴 무작위 문자열

# 알림톡 관리 (kakao-notify) — 아임웹/인스타 유입 고객 DB + 솔라피 알림톡 발송
# 솔라피(SOLAPI) — https://console.solapi.com 에서 API Key/Secret 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 사전 등록된 발신번호(숫자만)
SOLAPI_SENDER=
# 카카오 채널 PF ID
SOLAPI_PFID=
# 알림톡 템플릿(공통/아임웹/인스타)은 관리자 화면(알림톡 관리 > 설정)에서
# 목록 조회 후 선택해 저장합니다. 환경변수로는 지정하지 않습니다.

# 아임웹 — 관리자 > 확장연동 > Open API에서 key/secret 발급
IMWEB_API_KEY=
IMWEB_API_SECRET=

# 인스타 인스턴트 폼 DB (기존 Make 마스터시트를 그대로 소스로 사용)
# 구글 서비스 계정을 대상 스프레드시트에 "뷰어"로 공유해야 함
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
INSTAGRAM_SHEET_ID=
# INSTAGRAM_SHEET_RANGE=시트1!A2:I
# 시트 Apps Script(onChange 트리거)가 /public/kakao-notify/instagram-sheet-webhook
# 호출 시 함께 보내는 비밀 토큰. 임의의 긴 문자열로 설정.
INSTAGRAM_SHEET_WEBHOOK_SECRET=

# Quick tunnel (URL changes each restart):
#   powershell -File scripts/start-crawler-tunnel.ps1
# Auto-update Railway if PC .env has:
#   RAILWAY_TOKEN=...           (Railway -> Account Settings -> Tokens)
#   RAILWAY_SERVICE_ID=...      (optional, service Settings -> ID)
#
# Fixed URL (recommended): Cloudflare named tunnel + set
#   CRAWLER_TUNNEL_URL=https://crawler.yourdomain.com
#   CRAWLER_TUNNEL_NAME=auction-crawler

# 강의 다시보기 (lecture-replay) — Bunny Stream
# https://dash.bunny.net 에서 Stream 라이브러리 생성 후 Library ID 확인
BUNNY_STREAM_LIBRARY_ID=
# API Key는 현재 MVP 기능에서는 사용하지 않음(관리자가 영상 업로드 후
# video ID를 수동 입력하는 방식). 추후 Bunny API로 영상 목록을 직접
# 가져오는 기능을 붙일 때 사용 예정 — 절대 프론트에 노출하지 말 것.
BUNNY_STREAM_API_KEY=
# 라이브러리에서 Token Authentication을 켠 경우에만 필요.
# 설정하면 서버가 재생 URL을 서명해서 내려주고(만료 6시간),
# 비워두면 서명 없는 기본 embed URL을 사용함.
BUNNY_STREAM_TOKEN_KEY=
