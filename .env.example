# Railway PostgreSQL (Railway에서 DB 연결 시 자동 주입)
# DATABASE_URL=postgresql://...

# Vercel 프론트 URL (CORS, 쉼표로 여러 개 가능)
# FRONTEND_URL=https://your-app.vercel.app

# 탱크옥션 로그인 (관리자 PC 크롤러용 — Railway에는 불필요)
TANK_AUCTION_USER=
TANK_AUCTION_PASSWORD=

# 크롤러 워커 (관리자 PC 로컬용)
CRAWLER_WORKER_PORT=8765
CRAWLER_SECRET=local-crawler-secret
CRAWLER_CALLBACK_URL=http://127.0.0.1:3001/crawler/import-item

# Python 실행 경로 (선택)
# PYTHON_PATH=python

# 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
