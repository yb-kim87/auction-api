staged=$(git diff --cached --name-only)

code_changed=$(echo "$staged" | grep -E '\.(ts|tsx|py)$' | grep -v -E '^(tests/|scripts/_tmp)' || true)
docs_changed=$(echo "$staged" | grep -E '^docs/history/.*\.md$' || true)

if [ -n "$code_changed" ] && [ -z "$docs_changed" ]; then
  printf '\n\033[33m[알림] 코드 변경이 있는데 docs/history/*.md 변경이 없습니다.\033[0m\n'
  printf '  CLAUDE.md 규칙: 새 작업은 docs/history의 유사 문서에 追記하거나 신규 문서를 만들어야 합니다.\n'
  printf '  이미 문서화했거나 문서화가 불필요한 사소한 변경이면 이 메시지는 무시해도 됩니다.\n\n'
fi
